{
  "name":  "jensen",
  "version":  "0.1.0",
  "private":  true,
  "scripts":  {
          "dev":  "next dev",
          "build":  "next build",
          "start":  "next start",
          "lint":  "eslint . --max-warnings=0",
          "typecheck":  "next typegen \u0026\u0026 tsc --noEmit --incremental false",
          "test":  "vitest run",
          "test:watch":  "vitest",
          "check":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build",
          "audit:prod":  "npm audit --omit=dev --audit-level=high",
          "db:migrate":  "tsx scripts/migrate.ts",
          "db:prune":  "tsx scripts/prune.ts",
          "test:integration":  "vitest run --config vitest.integration.config.mts"
        },
  "dependencies":  {
            "jose":  "6.2.17",
            "mediabunny":  "1.65.2",
            "next":  "16.4.6",
            "openai":  "7.55.0",
            "openid-client":  "6.8.9",
            "pg":  "8.23.1",
            "react":  "19.1.0",
            "react-dom":  "19.1.0",
            "zod":  "4.6.7"
          },
  "devDependencies":  {
              "@testing-library/dom":  "10.4.2",
              "@testing-library/react":  "16.3.3",
              "@types/node":  "^22.15.30",
              "@types/pg":  "8.23.1",
              "@types/react":  "^19.1.8",
              "@types/react-dom":  "^19.1.6",
              "eslint":  "^9.28.0",
              "eslint-config-next":  "16.4.6",
              "jsdom":  "31.0.1",
              "tsx":  "4.23.15",
              "typescript":  "^5.8.3",
              "vitest":  "^5.1.0"
            },
  "engines":  {
          "node":  "\u003e=22.22.2 \u003c23"
        }
}
