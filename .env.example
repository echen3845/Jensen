AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-mini
XAI_API_KEY=xai-your-key-here
XAI_MODEL=grok-4.3
JENSEN_DEMO_MODE=false

# Per-request bounds (server-side; invalid values use bounded defaults)
JENSEN_CHAT_BODY_BYTES=65536
JENSEN_MAX_MESSAGES=32
JENSEN_MESSAGE_BYTES=8192
JENSEN_MODEL_INPUT_BYTES=24000
JENSEN_MODEL_OUTPUT_TOKENS=1024
JENSEN_AUDIO_BYTES=4194304
JENSEN_AUDIO_SECONDS=60
JENSEN_BODY_TIMEOUT_MS=15000
JENSEN_PROVIDER_TIMEOUT_MS=30000
JENSEN_PROVIDER_RETRIES=0

# Identity and durable state
APP_URL=http://localhost:3000
DATABASE_URL=postgres://jensen:change-me@127.0.0.1:55432/jensen
AUTH_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JENSEN_ALLOWED_EMAILS=

# Shared admission and operator-configured cost ceilings (required for live calls)
JENSEN_DAILY_MICRO_USD=1000000
JENSEN_GLOBAL_DAILY_MICRO_USD=10000000
JENSEN_USER_CONCURRENCY=2
JENSEN_GLOBAL_CONCURRENCY=8
JENSEN_REQUESTS_PER_MINUTE=30
JENSEN_ANONYMOUS_PER_MINUTE=120
JENSEN_IP_PER_MINUTE=10
JENSEN_TRUSTED_IP_HEADER=
JENSEN_CHAT_INPUT_MICRO_USD=
JENSEN_CHAT_OUTPUT_MICRO_USD=
JENSEN_AUDIO_MICRO_USD_PER_SECOND=

JENSEN_CREDENTIAL_KEYS={}
JENSEN_ACTIVE_CREDENTIAL_KEY=v1
